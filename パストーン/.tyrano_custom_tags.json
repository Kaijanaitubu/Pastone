{
  "customTags": [
    {
      "name": "chara_zoom",
      "description": "キャラクター立ち絵を拡大縮小（クロスフェード）",
      "attributes": {
        "name": {
          "required": true,
          "description": "対象キャラクター名"
        },
        "scale": {
          "required": false,
          "default": "1.0",
          "description": "拡大率（1.0=等倍）"
        },
        "time": {
          "required": false,
          "default": "600",
          "description": "アニメーション時間（ミリ秒）"
        },
        "origin_x": {
          "required": false,
          "default": "50%",
          "description": "拡大の中心点X座標"
        },
        "origin_y": {
          "required": false,
          "default": "50%",
          "description": "拡大の中心点Y座標"
        },
        "wait": {
          "required": false,
          "default": "true",
          "description": "アニメーション完了を待つか"
        }
      }
    },
    {
      "name": "bg_zoom",
